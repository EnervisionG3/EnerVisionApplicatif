# ============================================================
# EnerVision — environnement PRODUCTION / distant
#
# Copier en .env (jamais commité) :
#   Copy-Item .env.production.example .env
#
# Utilisé automatiquement par : docker compose up -d
# (Compose charge le fichier .env par défaut, sans flag supplémentaire —
#  c'est ce qui garantit que la commande par défaut est sûre pour la prod)
#
# Ce fichier ne contient QUE des placeholders vides : les vraies valeurs
# de production ne doivent jamais être commitées. Les secrets réels
# (mot de passe DB, client secret Keycloak) passent par
# secrets/db_password et secrets/keycloak_client_secret (Docker secrets),
# jamais par ce fichier.
# ============================================================

APP_ENVIRONMENT=production

# --- PostgreSQL ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PWD=
POSTGRES_APP_USER=
POSTGRES_APP_PWD=

# --- backend/core (pydantic Settings) ---
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=

# --- Keycloak : instance déjà déployée sur l'infrastructure distante.
# Ne JAMAIS pointer vers le Keycloak Docker local ici. ---
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=

# --- Frontend / workers ---
BACKEND_URL=http://backend:8000
MOCK_API_URL=

# --- Azure : STORAGE_ACCOUNT/CONTAINER_NAME/SAS_INGESTION utilisés par
# worker-ingestion (archivage brut) ; SAS_ETL/SAS_MLFLOW par
# script/verify_azure_access.py, pas par la stack Docker. ---
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER_NAME=
AZURE_SAS_INGESTION=
AZURE_SAS_ETL=
AZURE_SAS_MLFLOW=
